{
  "name": "@frontmcp/plugins",
  "version": "1.10.3",
  "description": "Meta-package that installs and re-exports the FrontMCP cache, CodeCall, dashboard and Remember plugins",
  "author": "AgentFront <info@agentfront.dev>",
  "homepage": "https://frontmcp.dev/reference/plugins",
  "license": "Apache-2.0",
  "keywords": [
    "frontmcp",
    "mcp",
    "model-context-protocol",
    "plugins",
    "cache",
    "codecall",
    "dashboard",
    "remember",
    "agentfront"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentfront/frontmcp.git",
    "directory": "libs/plugins"
  },
  "bugs": {
    "url": "https://github.com/agentfront/frontmcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@frontmcp/plugin-cache": "1.10.3",
    "@frontmcp/plugin-codecall": "1.10.3",
    "@frontmcp/plugin-dashboard": "1.10.3",
    "@frontmcp/plugin-remember": "1.10.3"
  },
  "peerDependencies": {
    "@frontmcp/sdk": "1.10.3"
  },
  "devDependencies": {
    "@frontmcp/sdk": "1.10.3"
  }
}
