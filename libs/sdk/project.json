{
  "name": "sdk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sdk/src",
  "projectType": "library",
  "tags": ["scope:libs", "scope:publishable", "versioning:synchronized"],
  "implicitDependencies": ["!observability"],
  "targets": {
    "build-cjs": {
      "executor": "@nx/esbuild:esbuild",
      "dependsOn": ["^build"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "libs/sdk/dist",
        "main": "libs/sdk/src/index.ts",
        "tsConfig": "libs/sdk/tsconfig.lib.json",
        "format": ["cjs"],
        "declaration": true,
        "declarationRootDir": "libs/sdk/src",
        "bundle": true,
        "thirdParty": false,
        "platform": "node",
        "additionalEntryPoints": [
          "libs/sdk/src/third-party/js-yaml.ts",
          "libs/sdk/src/third-party/lazy-js-yaml.ts",
          "libs/sdk/src/third-party/semver.ts",
          "libs/sdk/src/third-party/lazy-semver.ts",
          "libs/sdk/src/third-party/uipack-render.ts",
          "libs/sdk/src/third-party/lazy-uipack-render.ts"
        ],
        "assets": ["libs/sdk/README.md", "LICENSE", "libs/sdk/package.json"],
        "esbuildOptions": {
          "minifyWhitespace": true,
          "outExtension": { ".js": ".js" },
          "external": [
            "#js-yaml",
            "#semver",
            "#uipack-render",
            "@frontmcp/sdk",
            "@frontmcp/utils",
            "@frontmcp/di",
            "@frontmcp/lazy-zod",
            "@frontmcp/uipack",
            "@frontmcp/uipack/*",
            "@frontmcp/auth",
            "@frontmcp/guard",
            "@frontmcp/protocol",
            "@frontmcp/observability",
            "@opentelemetry/api",
            "@opentelemetry/sdk-trace-base",
            "ioredis",
            "jose",
            "reflect-metadata",
            "zod",
            "express",
            "cors",
            "raw-body",
            "content-type",
            "@vercel/kv",
            "#import-computed"
          ]
        }
      }
    },
    "build-esm": {
      "executor": "@nx/esbuild:esbuild",
      "dependsOn": ["build-cjs"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "libs/sdk/dist/esm",
        "main": "libs/sdk/src/index.ts",
        "tsConfig": "libs/sdk/tsconfig.lib.json",
        "format": ["esm"],
        "declaration": false,
        "bundle": true,
        "thirdParty": false,
        "platform": "node",
        "skipTypeCheck": true,
        "esbuildOptions": {
          "minifyWhitespace": true,
          "outExtension": { ".js": ".mjs" },
          "external": [
            "@frontmcp/sdk",
            "@frontmcp/utils",
            "@frontmcp/di",
            "@frontmcp/lazy-zod",
            "@frontmcp/uipack",
            "@frontmcp/uipack/*",
            "@frontmcp/auth",
            "@frontmcp/guard",
            "@frontmcp/protocol",
            "@frontmcp/observability",
            "@opentelemetry/api",
            "@opentelemetry/sdk-trace-base",
            "ioredis",
            "jose",
            "reflect-metadata",
            "zod",
            "express",
            "cors",
            "raw-body",
            "content-type",
            "@vercel/kv",
            "#import-computed"
          ]
        }
      }
    },
    "build-browser": {
      "executor": "@nx/esbuild:esbuild",
      "dependsOn": ["build-cjs"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "libs/sdk/dist/browser",
        "main": "libs/sdk/src/index.ts",
        "tsConfig": "libs/sdk/tsconfig.lib.json",
        "format": ["cjs"],
        "declaration": false,
        "bundle": true,
        "thirdParty": false,
        "platform": "node",
        "skipTypeCheck": true,
        "esbuildOptions": {
          "outExtension": { ".js": ".cjs" },
          "conditions": ["browser"],
          "external": [
            "@frontmcp/sdk",
            "@frontmcp/utils",
            "@frontmcp/di",
            "@frontmcp/lazy-zod",
            "@frontmcp/uipack",
            "@frontmcp/uipack/*",
            "@frontmcp/auth",
            "@frontmcp/guard",
            "@frontmcp/protocol",
            "@frontmcp/observability",
            "@opentelemetry/api",
            "@opentelemetry/sdk-trace-base",
            "ioredis",
            "jose",
            "reflect-metadata",
            "zod",
            "express",
            "cors",
            "raw-body",
            "content-type",
            "@vercel/kv",
            "#import-computed"
          ]
        }
      }
    },
    "build-browser-esm": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-browser"],
      "cache": true,
      "inputs": ["production", "^production", "{workspaceRoot}/scripts/build-browser-modules.mjs"],
      "outputs": ["{projectRoot}/dist/browser/**/*.mjs"],
      "options": {
        "command": "node scripts/build-browser-modules.mjs libs/sdk/src/index.ts libs/sdk/dist/browser libs/sdk/tsconfig.lib.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-cjs", "build-esm", "build-browser", "build-browser-esm"],
      "options": {
        "commands": [
          "npx esbuild libs/sdk/src/esm-loader/import-computed.ts --format=cjs --platform=node --outfile=libs/sdk/dist/esm-loader/import-computed.js",
          "npx esbuild libs/sdk/src/esm-loader/import-computed.ts --format=esm --platform=node --outfile=libs/sdk/dist/esm/esm-loader/import-computed.mjs",
          "node scripts/strip-dist-from-pkg.js libs/sdk/dist/package.json",
          "node scripts/inject-esm-require-banner.js libs/sdk/dist/esm libs/sdk/dist/browser",
          "node scripts/escape-non-ascii.mjs libs/sdk/dist"
        ],
        "parallel": false
      }
    },
    "test": {
      "dependsOn": ["^build", { "projects": ["uipack", "ui"], "target": "build" }],
      "options": {
        "command": "node --no-sparkplug ../../node_modules/jest/bin/jest.js"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npm publish libs/sdk/dist --access public --registry=https://registry.npmjs.org/"
      }
    },
    "publish-alpha": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "bash scripts/publish-alpha.sh {projectRoot}/dist",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
