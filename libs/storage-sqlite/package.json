{
  "name": "@frontmcp/storage-sqlite",
  "version": "1.10.10",
  "description": "SQLite storage for FrontMCP: sessions, background tasks, elicitations and stream events in a local file, without Redis",
  "author": "AgentFront <info@agentfront.dev>",
  "homepage": "https://frontmcp.dev/reference/deployment/sqlite",
  "license": "Apache-2.0",
  "keywords": [
    "frontmcp",
    "mcp",
    "model-context-protocol",
    "sqlite",
    "better-sqlite3",
    "storage",
    "session",
    "agentfront"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentfront/frontmcp.git",
    "directory": "libs/storage-sqlite"
  },
  "bugs": {
    "url": "https://github.com/agentfront/frontmcp/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@frontmcp/utils": "1.10.10",
    "better-sqlite3": "^12.6.2"
  },
  "peerDependencies": {
    "@frontmcp/lazy-zod": "1.10.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^5.9.3"
  }
}
