{
  "name": "@frontmcp/auth",
  "version": "1.10.9-rc.1",
  "description": "Authentication and authorization for FrontMCP servers: auth modes, OAuth 2.1 (local and remote), JWT and session checks, authorities and the credential vault",
  "author": "AgentFront <info@agentfront.dev>",
  "homepage": "https://frontmcp.dev/reference/auth",
  "license": "Apache-2.0",
  "keywords": [
    "frontmcp",
    "mcp",
    "model-context-protocol",
    "auth",
    "authentication",
    "authorization",
    "oauth",
    "oauth2",
    "jwt",
    "jwks",
    "pkce",
    "cimd",
    "session",
    "vault",
    "agentfront"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentfront/frontmcp.git",
    "directory": "libs/auth"
  },
  "bugs": {
    "url": "https://github.com/agentfront/frontmcp/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "@frontmcp/lazy-zod": "1.10.9-rc.1",
    "@frontmcp/storage-sqlite": "1.10.9-rc.1",
    "@vercel/kv": "^3.0.0",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@frontmcp/storage-sqlite": {
      "optional": true
    },
    "@vercel/kv": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "dependencies": {
    "@frontmcp/di": "1.10.9-rc.1",
    "@frontmcp/utils": "1.10.9-rc.1",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
