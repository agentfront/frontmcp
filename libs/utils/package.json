{
  "name": "@frontmcp/utils",
  "version": "1.10.16",
  "description": "Shared helpers for FrontMCP: URI templates, naming, cross-platform crypto and PKCE, key-value storage, file system and environment detection",
  "author": "AgentFront <info@agentfront.dev>",
  "license": "Apache-2.0",
  "keywords": [
    "frontmcp",
    "mcp",
    "utils",
    "uri-template",
    "crypto",
    "pkce",
    "storage",
    "redis",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentfront/frontmcp.git",
    "directory": "libs/utils"
  },
  "bugs": {
    "url": "https://github.com/agentfront/frontmcp/issues"
  },
  "homepage": "https://frontmcp.dev",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@enclave-vm/ast": "^2.17.0",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1"
  },
  "peerDependencies": {
    "@frontmcp/lazy-zod": "1.10.16",
    "@upstash/redis": "^1.34.0",
    "@vercel/kv": "^2.0.0 || ^3.0.0",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "@vercel/kv": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "imports": {
    "#crypto-provider": {
      "workerd": "./src/crypto/node.ts",
      "browser": "./src/crypto/browser.ts",
      "default": "./src/crypto/node.ts"
    },
    "#async-context": {
      "workerd": "./src/async-context/node-async-context.ts",
      "browser": "./src/async-context/browser-async-context.ts",
      "default": "./src/async-context/node-async-context.ts"
    },
    "#event-emitter": {
      "workerd": "./src/event-emitter/node-event-emitter.ts",
      "browser": "./src/event-emitter/browser-event-emitter.ts",
      "default": "./src/event-emitter/node-event-emitter.ts"
    },
    "#env": {
      "workerd": "./src/env/node-env.ts",
      "browser": "./src/env/browser-env.ts",
      "default": "./src/env/node-env.ts"
    },
    "#runtime-context": {
      "workerd": "./src/env/runtime-context.ts",
      "browser": "./src/env/browser-runtime-context.ts",
      "default": "./src/env/runtime-context.ts"
    },
    "#path": {
      "workerd": "./src/path/node-path.ts",
      "browser": "./src/path/browser-path.ts",
      "default": "./src/path/node-path.ts"
    }
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "workerd": {
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/esm/index.mjs"
        }
      },
      "browser": {
        "types": "./dist/index.d.ts",
        "import": "./dist/browser/index.mjs",
        "module": "./dist/browser/index.mjs",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.mjs"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
