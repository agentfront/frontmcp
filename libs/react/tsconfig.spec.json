{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": ["jest", "node"],
    "rootDir": "../..",
    "declaration": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.d.ts"]
}
