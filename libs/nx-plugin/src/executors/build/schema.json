{
  "$schema": "https://json-schema.org/schema",
  "title": "FrontMCP Build Executor",
  "description": "Compile a FrontMCP project",
  "type": "object",
  "properties": {
    "entry": {
      "type": "string",
      "description": "Entry file path"
    },
    "outputPath": {
      "type": "string",
      "description": "Output directory path"
    },
    "adapter": {
      "type": "string",
      "description": "Deprecated alias of `target`",
      "enum": [
        "node",
        "vercel",
        "lambda",
        "cloudflare"
      ]
    },
    "target": {
      "type": "string",
      "description": "Build target passed to `frontmcp build --target`",
      "enum": [
        "node",
        "vercel",
        "lambda",
        "cloudflare",
        "distributed",
        "cli",
        "sdk",
        "browser",
        "mcpb"
      ]
    }
  },
  "required": []
}
