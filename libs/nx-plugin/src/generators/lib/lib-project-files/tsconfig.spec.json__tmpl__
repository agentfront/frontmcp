{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "<%= offset %>dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "node10",<% if (ignoreDeprecations) { %>
    "ignoreDeprecations": "<%= ignoreDeprecations %>",<% } %>
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.d.ts"]
}
