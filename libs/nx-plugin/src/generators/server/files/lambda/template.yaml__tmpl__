AWSTemplateFormatVersion: '2010-09-09'
Transform: AWS::Serverless-2016-10-31
Description: '<%= className %> FrontMCP Server'

Parameters:
  McpSessionSecret:
    Type: String
    NoEcho: true
    Description: MCP_SESSION_SECRET for session-ID encryption, required in production (openssl rand -hex 32)

Globals:
  Function:
    Timeout: 30
    Runtime: nodejs24.x
    MemorySize: 256
    Environment:
      Variables:
        NODE_ENV: production
        MCP_SESSION_SECRET: !Ref McpSessionSecret

Resources:
  McpFunction:
    Type: AWS::Serverless::Function
    Properties:
      # `nx build <%= projectName %>` (target lambda) writes dist/lambda/handler.cjs, which exports `handler`.
      # It bundles @codegenie/serverless-express, so the function needs no layer.
      CodeUri: dist/lambda/
      Handler: handler.handler
      Events:
        Api:
          Type: HttpApi
          Properties:
            Path: /{proxy+}
            Method: ANY

Outputs:
  ApiUrl:
    Description: 'API Gateway URL'
    Value: !Sub 'https://${ServerlessHttpApi}.execute-api.${AWS::Region}.amazonaws.com'
