services:
  app:
    build:
      context: <%= offset %>
      dockerfile: <%= projectRoot %>/Dockerfile
    ports:
      - '${PORT:-3000}:3000'
    environment:
      - NODE_ENV=${NODE_ENV:-production}
      - PORT=${PORT:-3000}
      # Required in production (session-ID encryption). Compose stops here when it is unset.
      - MCP_SESSION_SECRET=${MCP_SESSION_SECRET:?set MCP_SESSION_SECRET (openssl rand -hex 32)}
<% if (redis === 'docker') { %>
      - REDIS_HOST=redis
      - REDIS_PORT=6379
    depends_on:
      redis:
        condition: service_healthy

  redis:
    image: redis:7-alpine
    # Loopback only: the app reaches Redis over the compose network, and a
    # Redis without a password must not listen on the host's public interfaces.
    ports:
      - '127.0.0.1:6379:6379'
    volumes:
      - redis-data:/data
    command: redis-server --appendonly yes
    healthcheck:
      test: ['CMD', 'redis-cli', 'ping']
      interval: 3s
      timeout: 5s
      retries: 3

volumes:
  redis-data:
<% } %>

# Generate MCP_SESSION_SECRET once and keep it in a .env file next to this file (a new value ends every open session):
#   echo "MCP_SESSION_SECRET=$(openssl rand -hex 32)" >> .env
#   docker compose up --build
# Selective rebuild:
#   docker compose up --build app   # rebuild only the app
#   docker compose up --build       # rebuild everything
