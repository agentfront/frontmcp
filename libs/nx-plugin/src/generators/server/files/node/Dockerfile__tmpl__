# Build from the workspace root: docker build -f <%= projectRoot %>/Dockerfile .
FROM node:24-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npx nx build <%= projectName %>

FROM node:24-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
# A production server needs MCP_SESSION_SECRET at runtime: docker run -e MCP_SESSION_SECRET=$(openssl rand -hex 32) ...
# The server binds 127.0.0.1 by default, which a published port cannot reach.
ENV FRONTMCP_BIND_ADDRESS=all
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
COPY --from=builder /app/<%= projectRoot %>/dist ./dist
COPY --from=builder /app/package.json /app/package-lock.json* ./
RUN npm ci --omit=dev --ignore-scripts
USER appuser
EXPOSE 3000
# `nx build <%= projectName %>` (target node) writes dist/node/<%= projectName %>.bundle.js
CMD ["node", "dist/node/<%= projectName %>.bundle.js"]
