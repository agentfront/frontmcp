# Build from the workspace root: docker build -f <%= projectRoot %>/Dockerfile .
FROM node:24-slim AS builder
WORKDIR /app
<% if (packageManager.docker.setup) { %>RUN <%= packageManager.docker.setup %>
<% } %>COPY . .
RUN <%= packageManager.docker.installFrozen %>
RUN <%= packageManager.exec %> nx build <%= projectName %>
RUN <%= packageManager.docker.pruneProduction %>

FROM node:24-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
# A production server needs MCP_SESSION_SECRET at runtime: docker run -e MCP_SESSION_SECRET=$(openssl rand -hex 32) ...
# The server binds 127.0.0.1 by default, which a published port cannot reach.
ENV FRONTMCP_BIND_ADDRESS=all
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/<%= projectRoot %>/dist ./dist
USER appuser
EXPOSE 3000
# `nx build <%= projectName %>` (target node) writes dist/node/<%= projectName %>.bundle.js
CMD ["node", "dist/node/<%= projectName %>.bundle.js"]
