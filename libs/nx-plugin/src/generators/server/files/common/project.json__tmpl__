{
  "name": "<%= projectName %>",
  "$schema": "<%= offset %>node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "<%= projectRoot %>/src",
  "projectType": "application",
  "tags": [<%- parsedTags.map(t => `"${t}"`).join(', ') %>],
  "targets": {
    "build": {
      "executor": "@frontmcp/nx:build",
      "cache": true,
      "outputs": [<%- buildOutputs.map(o => `"${o}"`).join(', ') %>],
      "options": {
        "entry": "{projectRoot}/src/main.ts",
        "outputPath": "{projectRoot}/dist",
        "target": "<%= deploymentTarget %>"
      }
    },
    "dev": {
      "executor": "@frontmcp/nx:dev",
      "options": {
        "entry": "{projectRoot}/src/main.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "deploy": {
      "executor": "@frontmcp/nx:deploy",
      "dependsOn": ["build"],
      "options": {
        "target": "<%= deploymentTarget %>"
      }
    }
  }
}
