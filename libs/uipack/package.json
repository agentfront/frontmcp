{
  "name": "@frontmcp/uipack",
  "version": "1.12.0-rc.1",
  "description": "React-free core that builds FrontMCP widget pages: HTML shell with CSP and bridge, template rendering, CDN import resolution",
  "author": "AgentFront <info@agentfront.dev>",
  "homepage": "https://frontmcp.dev/reference/ui/components#frontmcpuipack",
  "license": "Apache-2.0",
  "keywords": [
    "frontmcp",
    "mcp",
    "model-context-protocol",
    "mcp-apps",
    "widgets",
    "ui",
    "html",
    "csp",
    "import-map",
    "agentfront"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentfront/frontmcp.git",
    "directory": "libs/uipack"
  },
  "bugs": {
    "url": "https://github.com/agentfront/frontmcp/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.mjs"
      }
    },
    "./*": {
      "development": "./src/*/index.ts",
      "require": {
        "types": "./dist/*/index.d.ts",
        "default": "./dist/*/index.js"
      },
      "import": {
        "types": "./dist/*/index.d.ts",
        "default": "./dist/esm/*/index.mjs"
      }
    },
    "./esm": null
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "entities": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@frontmcp/lazy-zod": "1.12.0-rc.1",
    "@mdx-js/mdx": "^3.0.0",
    "esbuild": ">=0.27.0 <1",
    "highlight.js": "^11.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "remark-gfm": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@mdx-js/mdx": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    }
  }
}
