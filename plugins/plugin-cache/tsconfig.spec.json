{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "module": "NodeNext",
    "types": ["jest", "node"],
    "rootDir": "../..",
    "declaration": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.d.ts", "src/**/__tests__/**/*.ts"]
}
