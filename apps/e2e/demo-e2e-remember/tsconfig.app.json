{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": true
  },
  "exclude": ["jest.config.ts", "src/**/*.spec.ts"],
  "include": ["src/**/*.ts"]
}
