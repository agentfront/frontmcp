{
  "name": "demo-e2e-answer-shaping",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/e2e/demo-e2e-answer-shaping/src",
  "projectType": "application",
  "tags": ["scope:demo", "type:e2e", "feature:answer-shaping"],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "development",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/e2e/demo-e2e-answer-shaping",
        "main": "apps/e2e/demo-e2e-answer-shaping/src/main.ts",
        "tsConfig": "apps/e2e/demo-e2e-answer-shaping/tsconfig.app.json",
        "webpackConfig": "apps/e2e/demo-e2e-answer-shaping/webpack.config.js",
        "generatePackageJson": true
      },
      "configurations": {
        "development": {},
        "production": {
          "optimization": true
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/apps/e2e/demo-e2e-answer-shaping/main.js",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/e2e/demo-e2e-answer-shaping"],
      "options": {
        "jestConfig": "apps/e2e/demo-e2e-answer-shaping/jest.e2e.config.ts",
        "passWithNoTests": true
      },
      "dependsOn": [
        {
          "projects": ["plugin-result-handles", "observability"],
          "target": "build"
        }
      ]
    },
    "test:e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/e2e/demo-e2e-answer-shaping-e2e"],
      "options": {
        "jestConfig": "apps/e2e/demo-e2e-answer-shaping/jest.e2e.config.ts",
        "runInBand": true,
        "passWithNoTests": true
      },
      "dependsOn": [
        {
          "projects": ["plugin-result-handles", "observability"],
          "target": "build"
        }
      ]
    }
  }
}
